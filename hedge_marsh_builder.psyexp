        <Param val="$'Block 2: ' + mapping_condition + ' condition\n\n' + rule_text + '\n\nRespond as quickly and accurately as you can.\nIgnore where the circle appears, only its color matters.\n\nTrials run automatically one after another, just keep responding.\n\nPress space to begin a short practice round.'" valType="str" updates="set every repeat" name="text"/>
