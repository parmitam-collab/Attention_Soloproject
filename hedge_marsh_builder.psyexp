      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'color': 'red', 'xpos': -0.5, 'side': 'left'}, {'color': 'red', 'xpos': 0.5, 'side': 'right'}, {'color': 'green', 'xpos': -0.5, 'side': 'left'}, {'color': 'green', 'xpos': 0.5, 'side': 'right'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="conditions/conditions_practice.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="2" valType="code"/>
      <Param name="name" updates="None" val="practice_loop2" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="trial"/>
    <Routine name="iti_blank"/>
    <LoopTerminator name="practice_loop2"/>
    <Routine name="practice_done"/>
    <LoopInitiator loopType="TrialHandler" name="test_loop2">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'color': 'red', 'xpos': -0.5, 'side': 'left'}, {'color': 'red', 'xpos': 0.5, 'side': 'right'}, {'color': 'green', 'xpos': -0.5, 'side': 'left'}, {'color': 'green', 'xpos': 0.5, 'side': 'right'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="conditions/conditions_test.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="20" valType="code"/>
      <Param name="name" updates="None" val="test_loop2" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="trial"/>
    <Routine name="iti_blank"/>
    <LoopTerminator name="test_loop2"/>
    <Routine name="thanks"/>
  </Flow>
</PsychoPy2experiment>
