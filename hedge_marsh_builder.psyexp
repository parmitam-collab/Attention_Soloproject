        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="block_num = 2;&amp;#10;phase = &quot;practice&quot;;&amp;#10;mapping_condition = block2_condition;&amp;#10;if ((mapping_condition === &quot;Same-Color&quot;)) {&amp;#10;    rule_text = &quot;Press the RED-marked key when the circle is RED\nPress the GREEN-marked key when the circle is GREEN&quot;;&amp;#10;} else {&amp;#10;    rule_text = &quot;Press the GREEN-marked key when the circle is RED\nPress the RED-marked key when the circle is GREEN&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="block_num = 2&amp;#10;phase = &quot;practice&quot;&amp;#10;mapping_condition = block2_condition&amp;#10;if mapping_condition == &quot;Same-Color&quot;:&amp;#10;    rule_text = &quot;Press the RED-marked key when the circle is RED\nPress the GREEN-marked key when the circle is GREEN&quot;&amp;#10;else:&amp;#10;    rule_text = &quot;Press the GREEN-marked key when the circle is RED\nPress the RED-marked key when the circle is GREEN&quot;" valType="extendedCode" updates="constant" name="Begin Routine"/>
